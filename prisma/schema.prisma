// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shopify", "commerce", "whatsapp","billing"]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("shopify")
}

model ShopSettings {
  id   String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId],references: [id],onDelete: Cascade)

  onboardingCompleted Boolean  @default(false)
  plan                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@schema("shopify")
}

model Customer {
  id String @id @default(cuid())

  shopId String
  shop Shop   @relation(fields: [shopId],references: [id],onDelete: Cascade)

  phone String?
  email String?

  firstName String?
  lastName  String?

  shopifyCustomerId String?

  phones     CustomerPhone[]
  recoveries CheckoutRecovery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, shopifyCustomerId])
  
  @@schema("commerce")
}

model CustomerPhone {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId],references: [id],onDelete: Cascade)

  phone String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, endedAt])
  @@index([phone, endedAt])

  @@schema("commerce")
}

enum CheckoutRecoveryStatus {
  DETECTED
  MESSAGE_SENT
  ENGAGED
  COMPLETED
  EXPIRED
  CANCELLED
  @@schema("commerce")
}

model CheckoutRecovery {
  id String @id @default(cuid())

  shopId String
  shop Shop @relation(fields: [shopId],references: [id],onDelete: Cascade)

  checkoutToken String
  cartToken     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status CheckoutRecoveryStatus @default(DETECTED)

  currency    String?
  totalPrice  Decimal?
  checkoutUrl String?
  lineItems Json?

  detectedAt    DateTime  @default(now())
  messageSentAt DateTime?
  engagedAt     DateTime?
  completedAt   DateTime?
  expiredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]

  @@unique([shopId, checkoutToken])
  @@index([customerId])
  @@schema("commerce")
}

enum ConversationType {
  RECOVERY
  PRODUCT_DISCOVERY
  PRODUCT_SUPPORT
  POST_PURCHASE

  @@schema("whatsapp")
}

model Conversation {
  id String @id @default(cuid())

  checkoutRecoveryId String
  checkoutRecovery   CheckoutRecovery @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)

  type ConversationType

  inboundVersion       Int @default(0)
  lastProcessedVersion Int @default(0)

  summary String?

  lastInboundAt DateTime?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@unique([checkoutRecoveryId, type])
  @@index([checkoutRecoveryId])
  @@index([lastMessageAt])
  @@schema("whatsapp")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("whatsapp")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  AUTOMATION
  HUMAN

  @@schema("whatsapp")
}
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("whatsapp")
}
model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Meta's WhatsApp message ID
  providerMessageId String? @unique

  // Meta context.id when this message is a reply
  inReplyToProviderId String?

  direction  MessageDirection
  senderType MessageSenderType
  status MessageStatus @default(PENDING)

  content String

  createdAt DateTime @default(now())

  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?

  @@index([conversationId, createdAt])
  @@index([inReplyToProviderId])
  @@schema("whatsapp")
}

model BillingPlan {
  id              String   @id @default(cuid())

  handle          String   @unique
  name            String

  entitlements    Json
  limits          Json

  active          Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]

  @@schema("billing")
}

model Subscription {
  id                     String    @id @default(cuid())

  shopId                 String    @unique
  shop                   Shop      @relation(fields: [shopId],references: [id],onDelete: Cascade)

  planId                 String?
  plan                   BillingPlan? @relation(fields: [planId],references: [id])

  provider               String    @default("SHOPIFY")

  planHandle             String
  status                 String

  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)

  providerSubscriptionId String?

  lastSyncedAt           DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([planHandle])
  @@schema("billing")
}

model UsageEvent {
  id               String    @id @default(cuid())

  shopId           String
  shop             Shop      @relation(fields: [shopId],references: [id],onDelete: Cascade)

  metric           String
  quantity         Decimal

  idempotencyKey   String    @unique

  sourceType       String?
  sourceId         String?

  occurredAt       DateTime  @default(now())
  reportedAt       DateTime?

  provider         String    @default("SHOPIFY")
  providerResponse Json?

  createdAt        DateTime  @default(now())

  @@index([shopId, metric, occurredAt])
  @@schema("billing")
}

enum ShopStatus {
  ACTIVE
  UNINSTALLED
  SUSPENDED

  @@schema("commerce")
}

model Shop {
  id              String      @id @default(cuid())

  // Shopify identity
  domain          String      @unique
  shopifyShopId   String?     @unique

  // Installation lifecycle
  status          ShopStatus  @default(ACTIVE)
  installedAt     DateTime    @default(now())
  uninstalledAt   DateTime?

  // Configuration / billing
  settings        ShopSettings?
  subscriptions   Subscription[]
  usageEvents     UsageEvent[]

  // Commerce domain
  customers       Customer[]
  recoveries      CheckoutRecovery[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@schema("commerce")
}