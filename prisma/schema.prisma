// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shopify", "commerce", "whatsapp", "billing", "public", "support"]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("shopify")
}

model ShopSettings {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  onboardingCompleted  Boolean  @default(false)
  plan                 String?
  recoveryDelayMinutes Int      @default(30)
  defaultLanguageTag   String?
  defaultTimeZone      String?
  defaultCountryCode   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@schema("shopify")
}

model ShopBrand {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  brandName String?

  logoUrl     String?
  logoAltText String?
  logoWidth   Int?
  logoHeight  Int?

  squareLogoUrl     String?
  squareLogoAltText String?

  coverImageUrl String?

  fetchedAt       DateTime @default(now())
  lastRefreshedAt DateTime @updatedAt

  @@schema("shopify")
}

model Customer {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  phone String?
  email String?

  firstName String?
  lastName  String?

  shopifyCustomerId String?

  phones     CustomerPhone[]
  recoveries CheckoutRecovery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, shopifyCustomerId])
  @@schema("commerce")
}

model CustomerPhone {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  phone String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, endedAt])
  @@index([phone, endedAt])
  @@schema("commerce")
}

enum CheckoutRecoveryStatus {
  DETECTED
  MESSAGE_SENT
  ENGAGED
  COMPLETED
  EXPIRED
  CANCELLED

  @@schema("commerce")
}

model CheckoutRecoveryStatusHistory {
  id String @id @default(cuid())

  checkoutRecoveryId String
  checkoutRecovery   CheckoutRecovery @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)

  fromStatus CheckoutRecoveryStatus?
  toStatus   CheckoutRecoveryStatus

  reason   String?
  source   String?
  metadata Json?

  occurredAt DateTime @default(now())

  @@index([checkoutRecoveryId, occurredAt])
  @@index([toStatus, occurredAt])
  @@schema("commerce")
}

model CheckoutRecovery {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  checkoutToken String
  cartToken     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status CheckoutRecoveryStatus @default(DETECTED)

  currency    String?
  totalPrice  Decimal?
  checkoutUrl String?
  lineItems   Json?

  detectedAt    DateTime  @default(now())
  messageSentAt DateTime?
  engagedAt     DateTime?
  completedAt   DateTime?
  expiredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation  Conversation?
  statusHistory CheckoutRecoveryStatusHistory[]

  @@unique([shopId, checkoutToken])
  @@index([customerId])
  @@schema("commerce")
}

enum ConversationType {
  RECOVERY
  PRODUCT_DISCOVERY
  PRODUCT_SUPPORT
  POST_PURCHASE

  @@schema("whatsapp")
}

enum LanguageSource {
  CUSTOMER_EXPLICIT
  DETECTED
  SHOPIFY
  MERCHANT_DEFAULT
  PLATFORM_DEFAULT

  @@schema("whatsapp")
}

enum ConversationOutcome {
  IN_PROGRESS
  RECOVERED
  NO_RESPONSE
  DECLINED
  EXPIRED

  @@schema("whatsapp")
}

model Conversation {
  id String @id @default(cuid())

  checkoutRecoveryId String?
  checkoutRecovery   CheckoutRecovery? @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)

  type    ConversationType
  outcome ConversationOutcome @default(IN_PROGRESS)

  languageTag    String?
  languageSource LanguageSource?
  countryCode    String?
  currencyCode   String?
  timeZone       String?

  inboundVersion       Int @default(0)
  lastProcessedVersion Int @default(0)

  summary String?

  lastInboundAt DateTime?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@unique([checkoutRecoveryId])
  @@index([checkoutRecoveryId])
  @@index([lastMessageAt])
  @@schema("whatsapp")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("whatsapp")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  AUTOMATION
  HUMAN

  @@schema("whatsapp")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("whatsapp")
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Meta's WhatsApp message ID
  providerMessageId String? @unique

  // Meta context.id when this message is a reply
  inReplyToProviderId String?

  direction  MessageDirection
  senderType MessageSenderType
  status     MessageStatus     @default(PENDING)

  content String

  createdAt DateTime @default(now())

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([inReplyToProviderId])
  @@schema("whatsapp")
}

model BillingPlan {
  id String @id @default(cuid())

  handle String @unique
  name   String

  entitlements Json
  limits       Json

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@schema("billing")
}

model Subscription {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String?
  plan   BillingPlan? @relation(fields: [planId], references: [id])

  provider String @default("SHOPIFY")

  planHandle String
  status     String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  providerSubscriptionId String?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planHandle])
  @@schema("billing")
}

model UsageEvent {
  id String @id @default(cuid())

  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billingPeriodId String?
  billingPeriod   BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)

  metric   String
  quantity Decimal

  idempotencyKey String @unique

  sourceType String?
  sourceId   String?

  occurredAt DateTime  @default(now())
  reportedAt DateTime?

  provider         String @default("SHOPIFY")
  providerResponse Json?

  createdAt DateTime @default(now())

  @@index([shopId, metric, occurredAt])
  @@index([billingPeriodId])
  @@schema("billing")
}

model BillingPeriod {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  status      String       @default("OPEN")
  usageEvents UsageEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([shopId, periodStart])
  @@index([shopId, periodStart, periodEnd])
  @@schema("billing")
}

enum ShopStatus {
  ACTIVE
  UNINSTALLED
  SUSPENDED

  @@schema("commerce")
}

model Shop {
  id String @id @default(cuid())

  // Shopify identity
  domain        String  @unique
  shopifyShopId String? @unique

  // Installation lifecycle
  status        ShopStatus @default(ACTIVE)
  installedAt   DateTime   @default(now())
  uninstalledAt DateTime?

  // Configuration / billing
  settings                 ShopSettings?
  brand                    ShopBrand?
  subscriptions            Subscription[]
  usageEvents              UsageEvent[]
  billingPeriods           BillingPeriod[]
  whatsappTemplateVariants WhatsAppTemplateVariant[]
  merchantSupportThread    MerchantSupportThread?

  // Commerce domain
  customers  Customer[]
  recoveries CheckoutRecovery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@schema("commerce")
}

enum WhatsAppTemplateStatus {
  APPROVED
  IN_APPEAL
  PENDING
  REJECTED
  PENDING_DELETION
  DELETED
  DISABLED
  PAUSED
  LIMIT_EXCEEDED

  @@schema("whatsapp")
}

model WhatsAppTemplateVariant {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  providerAccountId    String
  purpose              String
  languageTag          String
  providerLanguageCode String
  providerTemplateName String
  providerTemplateId   String?
  status               WhatsAppTemplateStatus
  enabled              Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, providerAccountId, purpose, providerTemplateName, providerLanguageCode], map: "WhatsAppTemplateVariant_identity_key")
  @@index([shopId, providerAccountId, purpose, languageTag, enabled, status])
  @@schema("whatsapp")
}

model Tour {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city        String
  country     String
  title       String
  description String  @db.Text
  image       String? @db.Text
  stops       Json

  @@unique([city, country])
  @@schema("public")
}

model RagSearchResults {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer   Json
  prompt   Json
  astraDoc String @default("documentskodjobaah")

  @@schema("public")
}

enum PlatformAdminRole {
  ADMIN
  SUPER_ADMIN

  @@schema("public")
}

model PlatformAdmin {
  id              String            @id @default(cuid())
  provider        String            @default("google")
  providerSubject String?
  email           String            @unique
  displayName     String?
  role            PlatformAdminRole @default(ADMIN)
  active          Boolean           @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  assignedMerchantSupportThreads            MerchantSupportThread[]
  merchantSupportMessages                   MerchantSupportMessage[]
  merchantTranslationReconciliationRequests MerchantTranslationReconciliationRequest[]

  @@unique([provider, providerSubject])
  @@index([active, role])
  @@schema("public")
}

enum MerchantSupportMessageKind {
  ADMINISTRATIVE
  SYSTEM
  MERCHANT

  @@schema("support")
}

enum MerchantSupportMessageState {
  PROCESSING
  AVAILABLE
  FAILED

  @@schema("support")
}

model MerchantSupportThread {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  lastMessageAt               DateTime?
  lastMerchantMessageAt       DateTime?
  lastAdministrativeMessageAt DateTime?
  needsAdminResponse          Boolean   @default(false)
  merchantMessageVersion      Int       @default(0)

  assignedPlatformAdminId String?
  assignedPlatformAdmin   PlatformAdmin? @relation(fields: [assignedPlatformAdminId], references: [id], onDelete: SetNull)
  assignedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MerchantSupportMessage[]

  @@index([needsAdminResponse, lastMerchantMessageAt])
  @@index([assignedPlatformAdminId])
  @@schema("support")
}

model MerchantSupportMessage {
  id String @id @default(cuid())

  threadId String
  thread   MerchantSupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  kind  MerchantSupportMessageKind
  state MerchantSupportMessageState

  originalBody       String  @db.Text
  sourceLanguageTag  String
  displayLanguageTag String?

  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  shopifyUserId   String?
  systemCode      String?
  systemVersion   String?
  sourceKey       String?        @unique

  availableAt                    DateTime?
  readAt                         DateTime?
  respondsThroughMerchantVersion Int?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  translations MerchantMessageTranslation[]

  @@index([threadId, createdAt])
  @@index([platformAdminId])
  @@schema("support")
}

enum MerchantTranslationDirection {
  MERCHANT_TO_ADMIN
  ADMIN_TO_MERCHANT
  SYSTEM_TO_MERCHANT

  @@schema("support")
}

enum MerchantMessageTranslationStatus {
  PENDING
  AVAILABLE
  FAILED

  @@schema("support")
}

enum MerchantTranslationBatchStatus {
  READY
  SUBMITTING
  SUBMISSION_UNKNOWN
  SUBMITTED
  PROVIDER_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("support")
}

enum MerchantTranslationReconciliationScope {
  TRANSLATION
  FAILED_TRANSLATIONS

  @@schema("support")
}

enum MerchantTranslationReconciliationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("support")
}

model MerchantMessageTranslation {
  id String @id @default(cuid())

  messageId String
  message   MerchantSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  direction         MerchantTranslationDirection
  sourceLanguageTag String
  targetLanguageTag String
  status            MerchantMessageTranslationStatus
  translatedBody    String?                          @db.Text
  failureCode       String?
  retryCount        Int                              @default(0)
  nextAttemptAt     DateTime?

  currentBatchId String?
  currentBatch   MerchantTranslationBatch? @relation("CurrentTranslationBatch", fields: [currentBatchId], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  batchItems MerchantTranslationBatchItem[]

  @@unique([messageId, targetLanguageTag])
  @@index([status, currentBatchId, nextAttemptAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatch {
  id String @id @default(cuid())

  provider String
  model    String
  status   MerchantTranslationBatchStatus

  providerBatchId String?
  inputFileId     String?
  outputFileId    String?
  errorFileId     String?

  submissionStartedAt DateTime?
  lastSubmitAttemptAt DateTime?
  submitAttemptCount  Int       @default(0)
  nextSubmitAt        DateTime?
  submittedAt         DateTime?
  lastPolledAt        DateTime?
  nextPollAt          DateTime?
  pollSequence        Int       @default(0)
  completedAt         DateTime?
  failureCode         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  currentTranslations MerchantMessageTranslation[]   @relation("CurrentTranslationBatch")
  items               MerchantTranslationBatchItem[]

  @@unique([provider, providerBatchId])
  @@index([status, nextSubmitAt, createdAt])
  @@index([status, nextPollAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatchItem {
  id String @id @default(cuid())

  batchId          String
  batch            MerchantTranslationBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  translationId    String
  translation      MerchantMessageTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  providerCustomId String                     @unique
  createdAt        DateTime                   @default(now())

  @@unique([batchId, translationId])
  @@index([translationId, createdAt])
  @@schema("support")
}

model MerchantTranslationReconciliationRequest {
  id String @id @default(cuid())

  requestedByPlatformAdminId String
  requestedByPlatformAdmin   PlatformAdmin                           @relation(fields: [requestedByPlatformAdminId], references: [id])
  scope                      MerchantTranslationReconciliationScope
  translationId              String?
  status                     MerchantTranslationReconciliationStatus
  failureCode                String?
  requestedAt                DateTime                                @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?

  @@index([status, requestedAt])
  @@index([translationId, status])
  @@schema("support")
}
