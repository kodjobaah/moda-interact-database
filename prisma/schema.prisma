  source BillingLifecycleRequestSource

  sourceMessageId String?
  sourceMessage   MerchantSupportMessage? @relation("RecoveryCreditRefundSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  requestedByShopifyUserId String?

  purchaseCreditsGrantedSnapshot   Int
  currentAmountAtRequestSnapshot   Int
  reservedAmountAtRequestSnapshot  Int
  availableAmountAtRequestSnapshot Int
