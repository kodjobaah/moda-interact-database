  version     Int       @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, createdAt])
  @@index([status, createdAt, id])
  @@index([purchaseId, status, createdAt])
  @@index([sourceMessageId])
  @@index([approvedByPlatformAdminId, createdAt])
  @@index([providerConfirmedByPlatformAdminId, createdAt])
  @@schema("billing")
}

enum MerchantTranslationDirection {
  MERCHANT_TO_ADMIN
  ADMIN_TO_MERCHANT
  SYSTEM_TO_MERCHANT

  @@schema("support")
}

enum MerchantMessageTranslationStatus {
  PENDING
  AVAILABLE
  FAILED

  @@schema("support")
}

enum MerchantTranslationBatchStatus {
  READY
  SUBMITTING
  SUBMISSION_UNKNOWN
  SUBMITTED
  PROVIDER_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("support")
}

enum MerchantTranslationReconciliationScope {
  TRANSLATION
  FAILED_TRANSLATIONS

  @@schema("support")
}

enum MerchantTranslationReconciliationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("support")
}

model MerchantMessageTranslation {
  id String @id @default(cuid())

  messageId String
  message   MerchantSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  direction         MerchantTranslationDirection
  sourceLanguageTag String
  targetLanguageTag String
  status            MerchantMessageTranslationStatus
  translatedBody    String?                          @db.Text
  failureCode       String?
  retryCount        Int                              @default(0)
  nextAttemptAt     DateTime?

  currentBatchId String?
  currentBatch   MerchantTranslationBatch? @relation("CurrentTranslationBatch", fields: [currentBatchId], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  batchItems MerchantTranslationBatchItem[]

  @@unique([messageId, targetLanguageTag])
  @@index([status, currentBatchId, nextAttemptAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatch {
  id String @id @default(cuid())

  provider String
  model    String
  status   MerchantTranslationBatchStatus

  providerBatchId String?
  inputFileId     String?
  outputFileId    String?
  errorFileId     String?

  submissionStartedAt DateTime?
  lastSubmitAttemptAt DateTime?
  submitAttemptCount  Int       @default(0)
  nextSubmitAt        DateTime?
  submittedAt         DateTime?
  lastPolledAt        DateTime?
  nextPollAt          DateTime?
  pollSequence        Int       @default(0)
  completedAt         DateTime?
  failureCode         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  currentTranslations MerchantMessageTranslation[]   @relation("CurrentTranslationBatch")
  items               MerchantTranslationBatchItem[]

  @@unique([provider, providerBatchId])
  @@index([status, nextSubmitAt, createdAt])
  @@index([status, nextPollAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatchItem {
  id String @id @default(cuid())

  batchId          String
  batch            MerchantTranslationBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  translationId    String
  translation      MerchantMessageTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  providerCustomId String                     @unique
  createdAt        DateTime                   @default(now())

  @@unique([batchId, translationId])
  @@index([translationId, createdAt])
  @@schema("support")
}

model MerchantTranslationReconciliationRequest {
  id String @id @default(cuid())

  requestedByPlatformAdminId String
  requestedByPlatformAdmin   PlatformAdmin                           @relation(fields: [requestedByPlatformAdminId], references: [id])
  scope                      MerchantTranslationReconciliationScope
  translationId              String?
  status                     MerchantTranslationReconciliationStatus
  failureCode                String?
  requestedAt                DateTime                                @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?

  @@index([status, requestedAt])
  @@index([translationId, status])
  @@schema("support")
}

enum BackgroundRuntimeConfigSection {
  OPERATIONAL
  ADVANCED
  ABUSE_PROTECTION
  WORKER_THROUGHPUT

  @@schema("public")
}

enum BackgroundRuntimeLeaseName {
  BILLING_RECONCILIATION
  RECOVERY_CAPACITY_REPAIR
  TRANSLATION_RECONCILIATION
  QUEUE_CONCURRENCY_RECONCILIATION
  CHECKOUT_RECOVERY_EXPIRY

  @@schema("public")
}

model BackgroundRuntimeConfig {
  id      String @id @default("default")
  version Int    @default(0)

  billingReconciliationIntervalSeconds Int @default(60)
  billingReconciliationShopBatchSize   Int @default(50)
  shopifyUsagePublishBatchSize         Int @default(50)

  recoveryRepairIntervalSeconds Int @default(300)
  recoveryRepairShopBatchSize   Int @default(100)
  recoveryResumeBatchSize       Int @default(25)
  checkoutRecoveryLifetimeDays  Int @default(21)

  translationReconciliationIntervalSeconds Int @default(300)
  translationBatchMaxRequests              Int @default(100)

  conversationQuietWindowMs     Int @default(3000)
  conversationMaxSettleWindowMs Int @default(10000)

  billingFrozenRecheckSeconds Int @default(3600)
  billingProviderRetrySeconds Int @default(300)

  shopifyUsageRetryBaseSeconds Int @default(60)
  shopifyUsageRetryMaxSeconds  Int @default(3600)

  translationReconciliationPageSize Int @default(100)
  translationClaimTimeoutSeconds    Int @default(900)
  translationSubmitRetrySeconds     Int @default(300)
  translationInitialPollSeconds     Int @default(300)
  translationPollIntervalSeconds    Int @default(300)
  translationResultRetrySeconds     Int @default(300)
  translationSubmitMaxAttempts      Int @default(3)
  translationMaxAutoRetries         Int @default(3)

  rawSenderLimitPerMinute                 Int @default(60)
  rawGlobalLimitPerMinute                 Int @default(20000)
  turnSenderLimitPerMinute                Int @default(12)
  turnSenderLimitPerTenMinutes            Int @default(60)
  turnConversationLimitPerMinute          Int @default(12)
  turnConversationLimitPerTenMinutes      Int @default(60)
  turnShopLimitPerMinute                  Int @default(600)
  turnGlobalLimitPerMinute                Int @default(5000)
  discoverySenderLimitPerMinute           Int @default(4)
  discoverySenderLimitPerTenMinutes       Int @default(12)
  discoveryConversationLimitPerMinute     Int @default(4)
  discoveryConversationLimitPerTenMinutes Int @default(12)

  checkoutQueueGlobalConcurrency               Int @default(10)
  orderQueueGlobalConcurrency                  Int @default(5)
  pendingRecoveryQueueGlobalConcurrency        Int @default(10)
  recoveryResumeQueueGlobalConcurrency         Int @default(10)
  whatsappQueueGlobalConcurrency               Int @default(20)
  merchantCommunicationsQueueGlobalConcurrency Int @default(10)
  billingSubscriptionQueueGlobalConcurrency    Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEvents BackgroundRuntimeConfigAuditEvent[]

  @@schema("public")
}

model BackgroundRuntimeConfigAuditEvent {
  id String @id @default(cuid())

  configId String
  config   BackgroundRuntimeConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  section          BackgroundRuntimeConfigSection
  expectedVersion  Int
  resultingVersion Int

  platformAdminId String
  reason          String @db.VarChar(1000)

  beforeValue Json
  afterValue  Json

  createdAt DateTime @default(now())

  @@index([configId, createdAt])
  @@index([platformAdminId, createdAt])
  @@schema("public")
}

model BackgroundRuntimeLease {
  name BackgroundRuntimeLeaseName @id

  ownerToken String
  generation Int    @default(0)

  acquiredAt     DateTime
  heartbeatAt    DateTime
  leaseUntil     DateTime
  lastFinishedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([leaseUntil])
  @@schema("public")
}

// ARCH-020: SQL migration supplies JSON, publication and ownership guards.
model CommerceCapability {
  id               String                             @id @default(cuid()) @db.Text
  key              String                             @unique @db.VarChar(128)
  displayName      String                             @db.VarChar(255)
  description      String?                            @db.Text
  selectionBinding CommerceCapabilitySelectionBinding
  featureId        String?                            @db.Text
  enabled          Boolean                            @default(true)
  createdAt        DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                           @default(now()) @updatedAt @db.Timestamptz(3)
  feature          Feature?                           @relation(fields: [featureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions        CommerceCapabilityRevision[]
  auditEvents      CommerceAuditEvent[]

  @@index([featureId])
  @@schema("commerce")
}

model CommerceCapabilityRevision {
  id                 String                           @id @default(cuid()) @db.Text
  capabilityId       String                           @db.Text
  revisionNumber     Int
  status             CommerceCapabilityRevisionStatus @default(DRAFT)
  contractVersion    String                           @db.VarChar(64)
  editVersion        Int                              @default(0)
  contentHash        String?                          @db.VarChar(64)
  createdByAdminId   String                           @db.Text
  publishedByAdminId String?                          @db.Text
  createdAt          DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                         @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt        DateTime?                        @db.Timestamptz(3)
  promptTemplate     String                           @db.Text
  configuration      Json                             @default("{}") @db.JsonB
  toolBindings       Json                             @default("[]") @db.JsonB
  capability         CommerceCapability               @relation(fields: [capabilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          PlatformAdmin                    @relation("CommerceCapabilityRevisionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy        PlatformAdmin?                   @relation("CommerceCapabilityRevisionPublisher", fields: [publishedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releaseMembers     CommerceReleaseCapability[]
  auditEvents        CommerceAuditEvent[]

  @@unique([capabilityId, revisionNumber])
  @@unique([id, capabilityId])
  @@index([capabilityId, status, revisionNumber])
  @@schema("commerce")
}

model CommerceRelease {
  id                  String                      @id @default(cuid()) @db.Text
  releaseNumber       Int                         @unique @default(autoincrement())
  description         String?                     @db.Text
  runnerCompatibility String                      @db.VarChar(128)
  contractVersion     String                      @db.VarChar(64)
  createdByAdminId    String                      @db.Text
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  createdBy           PlatformAdmin               @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capabilities        CommerceReleaseCapability[]
  pointers            CommerceReleasePointer[]
  auditEvents         CommerceAuditEvent[]
  grants              CommerceConversationGrant[]

  @@index([createdAt, id])
  @@schema("commerce")
}

model CommerceReleaseCapability {
  releaseId            String                     @db.Text
  capabilityId         String                     @db.Text
  capabilityRevisionId String                     @db.Text
  position             Int
  release              CommerceRelease            @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision             CommerceCapabilityRevision @relation(fields: [capabilityRevisionId, capabilityId], references: [id, capabilityId], onDelete: Restrict, onUpdate: Restrict)

  @@id([releaseId, capabilityId])
  @@unique([releaseId, position])
  @@index([capabilityRevisionId, capabilityId])
  @@schema("commerce")
}

model CommerceReleasePointer {
  environment      CommerceEnvironment @id
  releaseId        String              @db.Text
  editVersion      Int                 @default(0)
  updatedByAdminId String              @db.Text
  updatedAt        DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  release          CommerceRelease     @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy        PlatformAdmin       @relation(fields: [updatedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([releaseId])
  @@schema("commerce")
}

model CommerceAuditEvent {
  id             String                      @id @default(cuid()) @db.Text
  actorAdminId   String                      @db.Text
  action         CommerceAuditAction
  capabilityId   String?                     @db.Text
  revisionId     String?                     @db.Text
  releaseId      String?                     @db.Text
  toolId         String?                     @db.Text
  toolRevisionId String?                     @db.Text
  environment    CommerceEnvironment?
  reason         String                      @db.VarChar(1000)
  metadata       Json                        @default("{}") @db.JsonB
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  actor          PlatformAdmin               @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capability     CommerceCapability?         @relation(fields: [capabilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision       CommerceCapabilityRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release        CommerceRelease?            @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tool           CommerceTool?               @relation(fields: [toolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toolRevision   CommerceToolRevision?       @relation(fields: [toolRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt, id])
  @@index([capabilityId, createdAt, id])
  @@index([releaseId, createdAt, id])
  @@index([actorAdminId, createdAt, id])
  @@index([toolId, createdAt, id])
  @@schema("commerce")
}

model CommerceConversationGrant {
  id                     String          @id @default(cuid()) @db.Text
  shopId                 String          @db.Text
  conversationId         String          @unique @db.Text
  initialInboundVersion  Int
  releaseId              String          @db.Text
  selectedCapabilityKeys Json            @db.JsonB
  grantedTools           Json            @db.JsonB
  runnerVersion          String          @db.VarChar(64)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt              DateTime?       @db.Timestamptz(3)
  shop                   Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  conversation           Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  release                CommerceRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shopId, createdAt, id])
  @@index([releaseId])
  @@index([expiresAt])
  @@schema("commerce")
}

model CommerceTool {
  id          String                 @id @default(cuid()) @db.Text
  name        String                 @unique @db.VarChar(128)
  displayName String                 @db.VarChar(255)
  description String?                @db.Text
  enabled     Boolean                @default(true)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  revisions   CommerceToolRevision[]
  auditEvents CommerceAuditEvent[]

  @@index([createdAt, id])
  @@schema("commerce")
}

model CommerceToolRevision {
  id                 String                           @id @default(cuid()) @db.Text
  toolId             String                           @db.Text
  revisionNumber     Int
  status             CommerceCapabilityRevisionStatus @default(DRAFT)
  contractVersion    String                           @db.VarChar(64)
  editVersion        Int                              @default(0)
  contentHash        String?                          @db.VarChar(64)
  createdByAdminId   String                           @db.Text
  publishedByAdminId String?                          @db.Text
  createdAt          DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                         @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt        DateTime?                        @db.Timestamptz(3)
  definitionVersion  String                           @db.VarChar(64)
  definition         Json                             @db.JsonB
  tool               CommerceTool                     @relation(fields: [toolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          PlatformAdmin                    @relation("CommerceToolRevisionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy        PlatformAdmin?                   @relation("CommerceToolRevisionPublisher", fields: [publishedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents        CommerceAuditEvent[]

  @@unique([toolId, revisionNumber])
  @@unique([toolId, definitionVersion])
  @@unique([id, toolId])
  @@index([toolId, status, revisionNumber])
  @@schema("commerce")
}

enum CommerceCapabilitySelectionBinding {
  BASE
  FEATURE
  RECOVERY_POLICY

  @@schema("commerce")
}

enum CommerceCapabilityRevisionStatus {
  DRAFT
  PUBLISHED

  @@schema("commerce")
}

enum CommerceEnvironment {
  LOCAL
  TEST
  DEVELOPMENT
  STAGING
  PRODUCTION

  @@schema("commerce")
}

enum CommerceAuditAction {
  CREATE_CAPABILITY
  UPDATE_CAPABILITY
  CREATE_DRAFT
  UPDATE_DRAFT
  PUBLISH_REVISION
  CREATE_RELEASE
  ACTIVATE_RELEASE
  ROLLBACK_RELEASE
  ENABLE_CAPABILITY
  DISABLE_CAPABILITY
  CREATE_TOOL
  UPDATE_TOOL
  CREATE_TOOL_DRAFT
  UPDATE_TOOL_DRAFT
  PUBLISH_TOOL_REVISION
  ENABLE_TOOL
  DISABLE_TOOL

  @@schema("commerce")
}
