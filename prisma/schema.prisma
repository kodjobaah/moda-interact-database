// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shopify", "commerce", "whatsapp", "billing", "public", "support"]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("shopify")
}

model ShopSettings {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  onboardingCompleted  Boolean  @default(false)
  plan                 String?
  recoveryDelayMinutes Int      @default(30)
  defaultLanguageTag   String?
  defaultTimeZone      String?
  defaultCountryCode   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@schema("shopify")
}

model ShopBrand {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  brandName String?

  logoUrl     String?
  logoAltText String?
  logoWidth   Int?
  logoHeight  Int?

  squareLogoUrl     String?
  squareLogoAltText String?

  coverImageUrl String?

  fetchedAt       DateTime @default(now())
  lastRefreshedAt DateTime @updatedAt

  @@schema("shopify")
}

model Customer {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  phone String?
  email String?

  firstName String?
  lastName  String?

  shopifyCustomerId String?

  phones                  CustomerPhone[]
  recoveries              CheckoutRecovery[]
  standaloneConversations Conversation[]     @relation("StandaloneConversationCustomer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, shopifyCustomerId])
  @@schema("commerce")
}

model CustomerPhone {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  phone String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, endedAt])
  @@index([phone, endedAt])
  @@schema("commerce")
}

enum CheckoutRecoveryStatus {
  DETECTED
  MESSAGE_SENT
  ENGAGED
  COMPLETED
  EXPIRED
  CANCELLED

  @@schema("commerce")
}

enum RecoveryAdmissionBlockReason {
  RECOVERY_CAPACITY_EXHAUSTED

  @@schema("commerce")
}

model CheckoutRecoveryStatusHistory {
  id String @id @default(cuid())

  checkoutRecoveryId String
  checkoutRecovery   CheckoutRecovery @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)

  fromStatus CheckoutRecoveryStatus?
  toStatus   CheckoutRecoveryStatus

  reason   String?
  source   String?
  metadata Json?

  occurredAt DateTime @default(now())

  @@index([checkoutRecoveryId, occurredAt])
  @@index([toStatus, occurredAt])
  @@schema("commerce")
}

model CheckoutRecovery {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  checkoutToken String
  cartToken     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status CheckoutRecoveryStatus @default(DETECTED)

  currency    String?
  totalPrice  Decimal?
  checkoutUrl String?
  lineItems   Json?

  detectedAt    DateTime  @default(now())
  messageSentAt DateTime?
  engagedAt     DateTime?
  completedAt   DateTime?
  expiredAt     DateTime?

  admissionBlockedAt   DateTime?
  admissionBlockReason RecoveryAdmissionBlockReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation  Conversation?
  statusHistory CheckoutRecoveryStatusHistory[]

  @@unique([shopId, checkoutToken])
  @@index([customerId])
  @@index([shopId, admissionBlockReason, status, detectedAt])
  @@schema("commerce")
}

enum ConversationType {
  RECOVERY
  PRODUCT_DISCOVERY
  PRODUCT_SUPPORT
  POST_PURCHASE

  @@schema("whatsapp")
}

enum LanguageSource {
  CUSTOMER_EXPLICIT
  DETECTED
  SHOPIFY
  MERCHANT_DEFAULT
  PLATFORM_DEFAULT

  @@schema("whatsapp")
}

enum ConversationOutcome {
  IN_PROGRESS
  RECOVERED
  NO_RESPONSE
  DECLINED
  EXPIRED

  @@schema("whatsapp")
}

model Conversation {
  id String @id @default(cuid())

  shopId     String?
  shop       Shop?     @relation("StandaloneConversationShop", fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation("StandaloneConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  checkoutRecoveryId String?
  checkoutRecovery   CheckoutRecovery? @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)
  standaloneScopeKey String?           @unique @db.VarChar(255)

  type    ConversationType
  outcome ConversationOutcome @default(IN_PROGRESS)

  languageTag    String?
  languageSource LanguageSource?
  countryCode    String?
  currencyCode   String?
  timeZone       String?

  inboundVersion           Int       @default(0)
  lastProcessedVersion     Int       @default(0)
  pendingTurnStartedAt     DateTime?
  processingInboundVersion Int?
  processingStartedAt      DateTime?

  summary String?

  lastInboundAt DateTime?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@unique([checkoutRecoveryId])
  @@index([checkoutRecoveryId])
  @@index([shopId, customerId, type, outcome])
  @@index([customerId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([processingStartedAt])
  @@schema("whatsapp")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("whatsapp")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  AUTOMATION
  HUMAN

  @@schema("whatsapp")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("whatsapp")
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Meta's WhatsApp message ID
  providerMessageId String? @unique

  // Meta context.id when this message is a reply
  inReplyToProviderId String?

  direction  MessageDirection
  senderType MessageSenderType
  status     MessageStatus     @default(PENDING)

  content String

  createdAt DateTime @default(now())

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([inReplyToProviderId])
  @@schema("whatsapp")
}

enum BillingPlanKind {
  FREE
  PAID_METERED

  @@schema("billing")
}

enum BillingPlanFeatureIdentifier {
  CHECKOUT_RECOVERY
  AI_CONVERSATIONS
  PRODUCT_SEARCH
  ORDER_SUPPORT

  @@schema("billing")
}

enum SubscriptionProjectionStatus {
  ACTIVE
  TRIALING
  NO_CONTRACT
  UNMAPPED
  SYNC_ERROR
  FROZEN

  @@schema("billing")
}

enum ProviderSubscriptionLifecycleState {
  CREATED
  UPDATED
  CANCELLATION_SCHEDULED
  CANCELED
  FROZEN
  UNFROZEN

  @@schema("billing")
}

enum BillingPeriodStatus {
  OPEN
  CLOSED

  @@schema("billing")
}

enum BillingPeriodCloseReason {
  RENEWED_SAME_PLAN
  PLAN_CHANGED
  CONTRACT_ENDED
  MIGRATION_RECONCILED

  @@schema("billing")
}

enum EntitlementCounter {
  FREE_RECOVERY_LIFETIME
  PURCHASED_RECOVERY_CREDITS
  PROMOTIONAL_RECOVERY_CREDITS

  @@schema("billing")
}

enum BillingPeriodEntitlementCounterKind {
  INCLUDED_RECOVERY_CREDITS

  @@schema("billing")
}

enum UsageReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  AMBIGUOUS

  @@schema("billing")
}

enum UsageReservationReleaseReason {
  PERIOD_CLOSED

  @@schema("billing")
}

enum UsageMetric {
  RECOVERY_CONVERSATION
  OUTBOUND_AUTOMATED_MESSAGE
  DELIVERED_WHATSAPP_MESSAGE
  RECOVERY_CREDIT_PACK_PURCHASE

  @@schema("billing")
}

enum RecoveryCreditPurchaseStatus {
  PENDING_BILLING
  ACTIVE
  NEEDS_ATTENTION
  CANCELLED
  REFUNDED

  @@schema("billing")
}

enum BillingLifecycleRequestSource {
  MERCHANT_UI
  MERCHANT_SUPPORT
  ADMIN

  @@schema("billing")
}

enum SubscriptionCancellationMode {
  END_OF_CYCLE
  IMMEDIATE_NO_PRORATION
  IMMEDIATE_PRORATED
  IMMEDIATE_SKIP_FINAL_USAGE

  @@schema("billing")
}

enum SubscriptionCancellationStatus {
  REQUESTED
  APPROVED
  PROCESSING
  RETRYABLE
  PROVIDER_ACCEPTED
  COMPLETED
  REJECTED
  WITHDRAWN
  NEEDS_ATTENTION

  @@schema("billing")
}

enum RecoveryCreditRefundSettlementMode {
  CURRENT_CYCLE_APP_EVENT_CORRECTION
  PARTNER_DASHBOARD_REFUND

  @@schema("billing")
}

enum RecoveryCreditProviderActionKind {
  REFUND
  CREDIT

  @@schema("billing")
}

enum RecoveryCreditRefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PROVIDER_PENDING
  PROVIDER_ACTION_REQUIRED
  PROVIDER_CONFIRMED
  COMPLETED
  REJECTED
  WITHDRAWN
  NEEDS_ATTENTION

  @@schema("billing")
}

enum ShopifyReportState {
  NOT_APPLICABLE
  PENDING
  IN_FLIGHT
  RETRYABLE
  REPORTED
  NEEDS_ATTENTION

  @@schema("billing")
}

enum BillingAuditAction {
  PLAN_CATALOG_CHANGED
  PLATFORM_POLICY_CHANGED
  SHOP_OVERRIDE_CHANGED
  SHOP_OVERRIDE_EXPIRED
  FREE_ALLOWANCE_ADJUSTED
  AUTOMATION_PAUSED
  AUTOMATION_RESUMED
  BILLING_EVENT_RETRY
  BILLING_CORRECTION_CREATED
  SUBSCRIPTION_CANCELLATION
  RECOVERY_CREDIT_REFUND
  PROMOTIONAL_CREDITS_GRANTED

  @@schema("billing")
}

model BillingPlan {
  id String @id @default(cuid())

  shopifyPlanHandle String          @unique
  name              String
  kind              BillingPlanKind
  active            Boolean         @default(true)

  shopifyUsageEventHandle               String?
  // Legacy catalog field; ARCH-010 runtime entitlement authority is the shop snapshot.
  freeLifetimeConversationAllowance     Int?
  includedRecoveryConversationAllowance Int?
  recoveryCreditPackEnabled             Boolean @default(false)
  recoveryCreditsPerPack                Int?
  shopifyRecoveryCreditPackEventHandle  String?
  defaultOutboundSoftLimit              Int
  defaultOutboundHardLimit              Int
  terminalMessageReservedSlots          Int     @default(1)

  features                BillingPlanFeature[]
  subscriptions           Subscription[]
  pendingSubscriptions    Subscription[]           @relation("PendingSubscriptionPlan")
  billingPeriods          BillingPeriod[]          @relation("BillingPeriodPlan")
  recoveryCreditPurchases RecoveryCreditPurchase[]
  promotionCampaigns      PromotionCampaign[]      @relation("PromotionCampaignTargetPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@schema("billing")
}

model BillingPlanFeature {
  id String @id @default(cuid())

  planId  String
  plan    BillingPlan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature BillingPlanFeatureIdentifier
  enabled Boolean                      @default(true)

  @@unique([planId, feature])
  @@schema("billing")
}

model Subscription {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String?
  plan   BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  observedShopifyPlanHandle String?
  status                    SubscriptionProjectionStatus

  billingPeriodId String?
  billingPeriod   BillingPeriod?  @relation("CurrentSubscriptionBillingPeriod", fields: [billingPeriodId], references: [id], onDelete: SetNull)
  billingPeriods  BillingPeriod[] @relation("SubscriptionBillingPeriods")

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  providerSubscriptionId String?

  lastSyncedAt      DateTime?
  lastSyncErrorCode String?
  lastSyncErrorAt   DateTime?

  pendingShopifyPlanHandle String?
  pendingPlanId            String?
  pendingPlan              BillingPlan? @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  pendingEffectiveAt       DateTime?
  nextReconcileAt          DateTime?

  lastProviderLifecycleState   ProviderSubscriptionLifecycleState?
  lastProviderLifecycleEventId String?
  lastProviderLifecycleEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([observedShopifyPlanHandle])
  @@index([status])
  @@index([billingPeriodId])
  @@index([nextReconcileAt])
  @@schema("billing")
}

model UsageEvent {
  id String @id @default(cuid())

  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billingPeriodId String?
  billingPeriod   BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)

  metric   UsageMetric
  quantity Decimal

  idempotencyKey String @unique

  correctionOfUsageEventId String?
  correctionOfUsageEvent   UsageEvent?       @relation("UsageEventCorrection", fields: [correctionOfUsageEventId], references: [id], onDelete: SetNull)
  corrections              UsageEvent[]      @relation("UsageEventCorrection")
  committedReservation     UsageReservation? @relation("CommittedReservation")

  sourceType String?
  sourceId   String?

  occurredAt DateTime @default(now())

  shopifyReportState      ShopifyReportState @default(NOT_APPLICABLE)
  shopifyEventHandle      String?
  shopifyIdempotencyKey   String?            @unique
  reportAttemptCount      Int                @default(0)
  nextReportAt            DateTime?
  lastReportAttemptAt     DateTime?
  reportedAt              DateTime?
  providerErrorCode       String?            @db.VarChar(128)
  providerResponseSummary String?            @db.VarChar(2000)

  provider String @default("SHOPIFY")

  recoveryCreditPurchase              RecoveryCreditPurchase?
  recoveryCreditRefundCorrectionEvent RecoveryCreditRefund?   @relation("RecoveryCreditRefundCorrectionEvent")

  createdAt DateTime @default(now())

  @@index([shopId, billingPeriodId, occurredAt])
  @@index([shopId, metric, occurredAt])
  @@index([shopifyReportState, nextReportAt, occurredAt])
  @@index([shopifyReportState, lastReportAttemptAt])
  @@index([correctionOfUsageEventId])
  @@index([billingPeriodId])
  @@schema("billing")
}

model ShopEntitlementCounter {
  id String @id @default(cuid())

  shopId            String
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counter           EntitlementCounter
  grantedQuantity   Int                @default(0)
  committedQuantity Int                @default(0)
  reservedQuantity  Int                @default(0)
  refundingQuantity Int                @default(0)
  version           Int                @default(0)

  reservations UsageReservation[] @relation("ShopEntitlementUsageReservations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, counter])
  @@index([shopId])
  @@schema("billing")
}

model BillingPeriodEntitlementCounter {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  billingPeriodId String
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)

  counter           BillingPeriodEntitlementCounterKind
  grantedQuantity   Int                                 @default(0)
  committedQuantity Int                                 @default(0)
  reservedQuantity  Int                                 @default(0)
  forfeitedQuantity Int                                 @default(0)
  version           Int                                 @default(0)

  reservations UsageReservation[] @relation("BillingPeriodUsageReservations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billingPeriodId, counter])
  @@index([shopId, billingPeriodId])
  @@schema("billing")
}

model RecoveryCreditPurchase {
  id String @id

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  planId String?
  plan   BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  shopifyPlanHandleSnapshot  String
  shopifyEventHandleSnapshot String
  creditsGranted             Int
  committedQuantity          Int    @default(0)
  reservedQuantity           Int    @default(0)
  refundingQuantity          Int    @default(0)
  refundedQuantity           Int    @default(0)
  version                    Int    @default(0)

  status RecoveryCreditPurchaseStatus @default(PENDING_BILLING)

  usageEventId String     @unique
  usageEvent   UsageEvent @relation(fields: [usageEventId], references: [id], onDelete: Restrict)

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refunds               RecoveryCreditRefund[]
  purchasedReservations UsageReservation[]

  @@index([shopId, status, createdAt])
  @@index([shopId, status, activatedAt, createdAt, id])
  @@index([planId, createdAt])
  @@schema("billing")
}

model UsageReservation {
  id String @id @default(cuid())

  shopId    String
  shop      Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId String?
  counter   ShopEntitlementCounter? @relation("ShopEntitlementUsageReservations", fields: [counterId], references: [id], onDelete: Cascade)

  billingPeriodEntitlementCounterId String?
  billingPeriodEntitlementCounter   BillingPeriodEntitlementCounter? @relation("BillingPeriodUsageReservations", fields: [billingPeriodEntitlementCounterId], references: [id], onDelete: Cascade)

  purchasedCreditPurchaseId String?
  purchasedCreditPurchase   RecoveryCreditPurchase? @relation(fields: [purchasedCreditPurchaseId], references: [id], onDelete: SetNull)

  promotionalCreditGrantId String?
  promotionalCreditGrant   PromotionalCreditGrant? @relation(fields: [promotionalCreditGrantId], references: [id], onDelete: SetNull)

  sourceKey     String                         @unique
  quantity      Int
  status        UsageReservationStatus         @default(RESERVED)
  releaseReason UsageReservationReleaseReason?
  expiresAt     DateTime?

  committedUsageEventId String?     @unique
  committedUsageEvent   UsageEvent? @relation("CommittedReservation", fields: [committedUsageEventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([status, expiresAt])
  @@index([purchasedCreditPurchaseId, status])
  @@index([promotionalCreditGrantId, status])
  @@index([billingPeriodEntitlementCounterId])
  @@schema("billing")
}

model PlatformBillingPolicy {
  id String @id @default("default")

  globalPauseNewRecoveries      Boolean @default(false)
  globalPauseAutomatedWhatsapp  Boolean @default(false)
  lifetimeFreeRecoveryAllowance Int     @default(5)
  absoluteOutboundHardLimit     Int
  defaultWarningPercent         Int
  version                       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("billing")
}

model ShopBillingPolicyOverride {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  outboundSoftLimit      Int?
  outboundHardLimit      Int?
  pauseNewRecoveries     Boolean?
  pauseAutomatedWhatsapp Boolean?
  recoverySafetyCeiling  Int?
  reason                 String    @db.VarChar(1000)
  expiresAt              DateTime?

  updatedByPlatformAdminId String?
  updatedByPlatformAdmin   PlatformAdmin? @relation(fields: [updatedByPlatformAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([shopId, expiresAt])
  @@index([updatedByPlatformAdminId])
  @@schema("billing")
}

model BillingAllowanceAdjustment {
  id String @id @default(cuid())

  shopId   String
  shop     Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  counter  EntitlementCounter @default(FREE_RECOVERY_LIFETIME)
  quantity Int
  reason   String             @db.VarChar(1000)

  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shopId, counter, createdAt])
  @@index([platformAdminId, createdAt])
  @@schema("billing")
}

enum PromotionalCreditGrantType {
  CAMPAIGN
  BETA_TESTER
  GOODWILL
  SUPPORT
  INTERNAL_TEST
  OTHER

  @@schema("billing")
}

enum PromotionTargetScope {
  GLOBAL
  PLAN
  SHOP

  @@schema("billing")
}

enum PromotionCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@schema("billing")
}

enum PromotionCampaignEventType {
  CREATED
  ACTIVATED
  CLOSED
  REOPENED
  EXPIRY_CHANGED

  @@schema("billing")
}

model PromotionCampaign {
  id                  String               @id @default(cuid())
  name                String
  merchantDescription String?              @db.Text
  scope               PromotionTargetScope
  quantity            Int

  targetPlanId String?
  targetPlan   BillingPlan? @relation("PromotionCampaignTargetPlan", fields: [targetPlanId], references: [id], onDelete: Restrict)
  targetShopId String?
  targetShop   Shop?        @relation("PromotionCampaignTargetShop", fields: [targetShopId], references: [id], onDelete: Restrict)

  startsAt  DateTime
  expiresAt DateTime
  status    PromotionCampaignStatus

  createdByPlatformAdminId String
  createdByPlatformAdmin   PlatformAdmin @relation("PromotionCampaignCreator", fields: [createdByPlatformAdminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  events                  PromotionCampaignEvent[]
  promotionalCreditGrants PromotionalCreditGrant[]

  @@index([status, startsAt, expiresAt])
  @@index([targetPlanId, status, startsAt, expiresAt])
  @@index([targetShopId, status, startsAt, expiresAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@schema("billing")
}

model PromotionCampaignEvent {
  id String @id @default(cuid())

  campaignId String
  campaign   PromotionCampaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  kind       PromotionCampaignEventType

  oldExpiresAt DateTime?
  newExpiresAt DateTime?

  platformAdminId String
  platformAdmin   PlatformAdmin @relation("PromotionCampaignEvents", fields: [platformAdminId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@index([campaignId, createdAt])
  @@index([platformAdminId, createdAt])
  @@schema("billing")
}

model PromotionalCreditGrant {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  quantity          Int
  grantType         PromotionalCreditGrantType
  reason            String                     @db.VarChar(1000)
  campaignReference String?                    @db.VarChar(255)
  requestKey        String                     @unique @db.VarChar(255)
  platformAdminId   String
  platformAdmin     PlatformAdmin              @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)
  campaignId        String?
  campaign          PromotionCampaign?         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reservedQuantity  Int                        @default(0)
  committedQuantity Int                        @default(0)
  firstSelectedAt   DateTime?
  lastSelectedAt    DateTime?
  selectionCount    Int                        @default(0)
  firstUsedAt       DateTime?
  lastUsedAt        DateTime?
  exhaustedAt       DateTime?
  version           Int                        @default(0)
  createdAt         DateTime                   @default(now())

  reservations UsageReservation[]
  selection    MerchantPromotionSelection?

  @@unique([campaignId, shopId])
  @@unique([id, shopId])
  @@index([shopId, createdAt])
  @@index([campaignReference, createdAt])
  @@index([platformAdminId, createdAt])
  @@schema("billing")
}

model MerchantPromotionSelection {
  id                       String                 @id @default(cuid())
  shopId                   String                 @unique
  shop                     Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  promotionalCreditGrantId String                 @unique
  promotionalCreditGrant   PromotionalCreditGrant @relation(fields: [promotionalCreditGrantId, shopId], references: [id, shopId], onDelete: Restrict)
  selectedAt               DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  version                  Int                    @default(0)

  @@unique([promotionalCreditGrantId, shopId])
  @@schema("billing")
}

model BillingAuditEvent {
  id String @id @default(cuid())

  action BillingAuditAction
  shopId String?
  shop   Shop?              @relation(fields: [shopId], references: [id], onDelete: SetNull)

  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  reason            String?  @db.VarChar(1000)
  beforeValue       Json?
  afterValue        Json?
  relatedEntityType String?  @db.VarChar(128)
  relatedEntityId   String?  @db.VarChar(256)
  createdAt         DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([platformAdminId, createdAt])
  @@index([action, createdAt])
  @@schema("billing")
}

model BillingPeriod {
  id                             String                            @id @default(cuid())
  shopId                         String
  shop                           Shop                              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId                 String
  subscription                   Subscription                      @relation("SubscriptionBillingPeriods", fields: [subscriptionId], references: [id], onDelete: Restrict)
  currentForSubscriptions        Subscription[]                    @relation("CurrentSubscriptionBillingPeriod")
  planId                         String?
  plan                           BillingPlan?                      @relation("BillingPeriodPlan", fields: [planId], references: [id], onDelete: SetNull)
  shopifyPlanHandleSnapshot      String?
  planNameSnapshot               String?
  planKindSnapshot               BillingPlanKind?
  includedRecoveryCreditsGranted Int?
  periodStart                    DateTime
  periodEnd                      DateTime
  status                         BillingPeriodStatus               @default(OPEN)
  closedAt                       DateTime?
  closeReason                    BillingPeriodCloseReason?
  usageEvents                    UsageEvent[]
  entitlementCounters            BillingPeriodEntitlementCounter[]
  createdAt                      DateTime                          @default(now())
  updatedAt                      DateTime                          @updatedAt

  @@unique([shopId, periodStart, periodEnd])
  @@index([shopId, periodStart, periodEnd])
  @@index([subscriptionId, periodStart, periodEnd])
  @@schema("billing")
}

enum ShopStatus {
  ACTIVE
  UNINSTALLED
  SUSPENDED

  @@schema("commerce")
}

model Shop {
  id String @id @default(cuid())

  // Shopify identity
  domain        String  @unique
  shopifyShopId String? @unique

  // Installation lifecycle
  status             ShopStatus @default(ACTIVE)
  installedAt        DateTime   @default(now())
  uninstalledAt      DateTime?
  reinstallPendingAt DateTime?

  // Configuration / billing
  settings                         ShopSettings?
  brand                            ShopBrand?
  subscription                     Subscription?
  usageEvents                      UsageEvent[]
  billingPeriods                   BillingPeriod[]
  entitlementCounters              ShopEntitlementCounter[]
  billingPeriodEntitlementCounters BillingPeriodEntitlementCounter[]
  usageReservations                UsageReservation[]
  billingPolicyOverride            ShopBillingPolicyOverride?
  allowanceAdjustments             BillingAllowanceAdjustment[]
  billingAuditEvents               BillingAuditEvent[]
  recoveryCreditPurchases          RecoveryCreditPurchase[]
  promotionalCreditGrants          PromotionalCreditGrant[]
  merchantPromotionSelection       MerchantPromotionSelection?
  promotionCampaigns               PromotionCampaign[]               @relation("PromotionCampaignTargetShop")
  subscriptionCancellationRequests SubscriptionCancellationRequest[]
  recoveryCreditRefunds            RecoveryCreditRefund[]
  whatsappTemplateVariants         WhatsAppTemplateVariant[]
  merchantSupportThread            MerchantSupportThread?

  // Commerce domain
  customers               Customer[]
  recoveries              CheckoutRecovery[]
  standaloneConversations Conversation[]     @relation("StandaloneConversationShop")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, reinstallPendingAt])
  @@schema("commerce")
}

enum WhatsAppTemplateStatus {
  APPROVED
  IN_APPEAL
  PENDING
  REJECTED
  PENDING_DELETION
  DELETED
  DISABLED
  PAUSED
  LIMIT_EXCEEDED

  @@schema("whatsapp")
}

model WhatsAppTemplateVariant {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  providerAccountId    String
  purpose              String
  languageTag          String
  providerLanguageCode String
  providerTemplateName String
  providerTemplateId   String?
  status               WhatsAppTemplateStatus
  enabled              Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, providerAccountId, purpose, providerTemplateName, providerLanguageCode], map: "WhatsAppTemplateVariant_identity_key")
  @@index([shopId, providerAccountId, purpose, languageTag, enabled, status])
  @@schema("whatsapp")
}

model Tour {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city        String
  country     String
  title       String
  description String  @db.Text
  image       String? @db.Text
  stops       Json

  @@unique([city, country])
  @@schema("public")
}

model RagSearchResults {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answer   Json
  prompt   Json
  astraDoc String @default("documentskodjobaah")

  @@schema("public")
}

enum PlatformAdminRole {
  ADMIN
  SUPER_ADMIN

  @@schema("public")
}

model PlatformAdmin {
  id              String            @id @default(cuid())
  provider        String            @default("google")
  providerSubject String?
  email           String            @unique
  displayName     String?
  role            PlatformAdminRole @default(ADMIN)
  active          Boolean           @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  assignedMerchantSupportThreads            MerchantSupportThread[]
  merchantSupportMessages                   MerchantSupportMessage[]
  merchantTranslationReconciliationRequests MerchantTranslationReconciliationRequest[]
  shopBillingPolicyOverrides                ShopBillingPolicyOverride[]
  billingAllowanceAdjustments               BillingAllowanceAdjustment[]
  billingAuditEvents                        BillingAuditEvent[]
  createdPromotionCampaigns                 PromotionCampaign[]                        @relation("PromotionCampaignCreator")
  promotionCampaignEvents                   PromotionCampaignEvent[]                   @relation("PromotionCampaignEvents")
  approvedSubscriptionCancellations         SubscriptionCancellationRequest[]          @relation("ApprovedSubscriptionCancellations")
  approvedRecoveryCreditRefunds             RecoveryCreditRefund[]                     @relation("ApprovedRecoveryCreditRefunds")
  confirmedRecoveryCreditRefunds            RecoveryCreditRefund[]                     @relation("ConfirmedRecoveryCreditRefunds")
  promotionalCreditGrants                   PromotionalCreditGrant[]

  @@unique([provider, providerSubject])
  @@index([active, role])
  @@schema("public")
}

enum MerchantSupportMessageKind {
  ADMINISTRATIVE
  SYSTEM
  MERCHANT

  @@schema("support")
}

enum MerchantSupportMessageState {
  PROCESSING
  AVAILABLE
  FAILED

  @@schema("support")
}

model MerchantSupportThread {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  lastMessageAt               DateTime?
  lastMerchantMessageAt       DateTime?
  lastAdministrativeMessageAt DateTime?
  needsAdminResponse          Boolean   @default(false)
  merchantMessageVersion      Int       @default(0)

  assignedPlatformAdminId String?
  assignedPlatformAdmin   PlatformAdmin? @relation(fields: [assignedPlatformAdminId], references: [id], onDelete: SetNull)
  assignedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MerchantSupportMessage[]

  @@index([needsAdminResponse, lastMerchantMessageAt])
  @@index([assignedPlatformAdminId])
  @@schema("support")
}

model MerchantSupportMessage {
  id String @id @default(cuid())

  threadId String
  thread   MerchantSupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  kind  MerchantSupportMessageKind
  state MerchantSupportMessageState

  originalBody       String  @db.Text
  sourceLanguageTag  String
  displayLanguageTag String?

  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  shopifyUserId   String?
  systemCode      String?
  systemVersion   String?
  sourceKey       String?        @unique

  availableAt                    DateTime?
  readAt                         DateTime?
  respondsThroughMerchantVersion Int?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  translations                           MerchantMessageTranslation[]
  subscriptionCancellationSourceRequests SubscriptionCancellationRequest[] @relation("SubscriptionCancellationSourceMessage")
  recoveryCreditRefundSourceRequests     RecoveryCreditRefund[]            @relation("RecoveryCreditRefundSourceMessage")

  @@index([threadId, createdAt])
  @@index([platformAdminId])
  @@schema("support")
}

model SubscriptionCancellationRequest {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  source BillingLifecycleRequestSource

  sourceMessageId String?
  sourceMessage   MerchantSupportMessage? @relation("SubscriptionCancellationSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  requestedByShopifyUserId String?

  providerSubscriptionIdSnapshot String
  planHandleSnapshot             String
  currentPeriodEndSnapshot       DateTime?

  mode   SubscriptionCancellationMode   @default(END_OF_CYCLE)
  status SubscriptionCancellationStatus @default(REQUESTED)

  requestKey String  @unique @db.VarChar(255)
  reason     String? @db.VarChar(1000)

  approvedByPlatformAdminId String?
  approvedByPlatformAdmin   PlatformAdmin? @relation("ApprovedSubscriptionCancellations", fields: [approvedByPlatformAdminId], references: [id], onDelete: SetNull)
  approvedAt                DateTime?

  version             Int       @default(0)
  attemptCount        Int       @default(0)
  nextAttemptAt       DateTime?
  lastAttemptAt       DateTime?
  processingStartedAt DateTime?

  providerAcceptedAt      DateTime?
  providerErrorCode       String?   @db.VarChar(128)
  providerResponseSummary String?   @db.VarChar(2000)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([sourceMessageId])
  @@index([approvedByPlatformAdminId, createdAt])
  @@schema("billing")
}

model RecoveryCreditRefund {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   RecoveryCreditPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  source BillingLifecycleRequestSource

  sourceMessageId String?
  sourceMessage   MerchantSupportMessage? @relation("RecoveryCreditRefundSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  requestedByShopifyUserId String?

  originalUsageEventIdSnapshot   String
  billingPeriodIdSnapshot        String?
  planHandleSnapshot             String
  eventHandleSnapshot            String
  creditsSnapshot                Int
  purchaseCreditsGrantedSnapshot Int
  creditsRequested               Int
  creditsApproved                Int?
  creditsRefunded                Int?

  settlementMode RecoveryCreditRefundSettlementMode?
  status         RecoveryCreditRefundStatus          @default(REQUESTED)

  requestKey String  @unique @db.VarChar(255)
  reason     String? @db.VarChar(1000)

  approvedByPlatformAdminId String?
  approvedByPlatformAdmin   PlatformAdmin? @relation("ApprovedRecoveryCreditRefunds", fields: [approvedByPlatformAdminId], references: [id], onDelete: SetNull)
  approvedAt                DateTime?

  holdAppliedAt DateTime?

  correctionUsageEventId String?     @unique
  correctionUsageEvent   UsageEvent? @relation("RecoveryCreditRefundCorrectionEvent", fields: [correctionUsageEventId], references: [id], onDelete: Restrict)

  providerReference  String?                           @db.VarChar(512)
  providerActionKind RecoveryCreditProviderActionKind?
  providerAmount     Decimal?                          @db.Decimal(20, 2)
  providerCurrency   String?                           @db.VarChar(3)

  providerConfirmedByPlatformAdminId String?
  providerConfirmedByPlatformAdmin   PlatformAdmin? @relation("ConfirmedRecoveryCreditRefunds", fields: [providerConfirmedByPlatformAdminId], references: [id], onDelete: SetNull)
  providerConfirmedAt                DateTime?

  version             Int       @default(0)
  attemptCount        Int       @default(0)
  nextAttemptAt       DateTime?
  lastAttemptAt       DateTime?
  processingStartedAt DateTime?

  providerErrorCode       String? @db.VarChar(128)
  providerResponseSummary String? @db.VarChar(2000)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, createdAt])
  @@index([purchaseId, status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([sourceMessageId])
  @@index([approvedByPlatformAdminId, createdAt])
  @@index([providerConfirmedByPlatformAdminId, createdAt])
  @@schema("billing")
}

enum MerchantTranslationDirection {
  MERCHANT_TO_ADMIN
  ADMIN_TO_MERCHANT
  SYSTEM_TO_MERCHANT

  @@schema("support")
}

enum MerchantMessageTranslationStatus {
  PENDING
  AVAILABLE
  FAILED

  @@schema("support")
}

enum MerchantTranslationBatchStatus {
  READY
  SUBMITTING
  SUBMISSION_UNKNOWN
  SUBMITTED
  PROVIDER_COMPLETED
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("support")
}

enum MerchantTranslationReconciliationScope {
  TRANSLATION
  FAILED_TRANSLATIONS

  @@schema("support")
}

enum MerchantTranslationReconciliationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("support")
}

model MerchantMessageTranslation {
  id String @id @default(cuid())

  messageId String
  message   MerchantSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  direction         MerchantTranslationDirection
  sourceLanguageTag String
  targetLanguageTag String
  status            MerchantMessageTranslationStatus
  translatedBody    String?                          @db.Text
  failureCode       String?
  retryCount        Int                              @default(0)
  nextAttemptAt     DateTime?

  currentBatchId String?
  currentBatch   MerchantTranslationBatch? @relation("CurrentTranslationBatch", fields: [currentBatchId], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  batchItems MerchantTranslationBatchItem[]

  @@unique([messageId, targetLanguageTag])
  @@index([status, currentBatchId, nextAttemptAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatch {
  id String @id @default(cuid())

  provider String
  model    String
  status   MerchantTranslationBatchStatus

  providerBatchId String?
  inputFileId     String?
  outputFileId    String?
  errorFileId     String?

  submissionStartedAt DateTime?
  lastSubmitAttemptAt DateTime?
  submitAttemptCount  Int       @default(0)
  nextSubmitAt        DateTime?
  submittedAt         DateTime?
  lastPolledAt        DateTime?
  nextPollAt          DateTime?
  pollSequence        Int       @default(0)
  completedAt         DateTime?
  failureCode         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  currentTranslations MerchantMessageTranslation[]   @relation("CurrentTranslationBatch")
  items               MerchantTranslationBatchItem[]

  @@unique([provider, providerBatchId])
  @@index([status, nextSubmitAt, createdAt])
  @@index([status, nextPollAt, createdAt])
  @@schema("support")
}

model MerchantTranslationBatchItem {
  id String @id @default(cuid())

  batchId          String
  batch            MerchantTranslationBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  translationId    String
  translation      MerchantMessageTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  providerCustomId String                     @unique
  createdAt        DateTime                   @default(now())

  @@unique([batchId, translationId])
  @@index([translationId, createdAt])
  @@schema("support")
}

model MerchantTranslationReconciliationRequest {
  id String @id @default(cuid())

  requestedByPlatformAdminId String
  requestedByPlatformAdmin   PlatformAdmin                           @relation(fields: [requestedByPlatformAdminId], references: [id])
  scope                      MerchantTranslationReconciliationScope
  translationId              String?
  status                     MerchantTranslationReconciliationStatus
  failureCode                String?
  requestedAt                DateTime                                @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?

  @@index([status, requestedAt])
  @@index([translationId, status])
  @@schema("support")
}
