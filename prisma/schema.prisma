// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shopify", "commerce", "whatsapp", "billing", "public", "support", "woocommerce"]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("shopify")
}

model ShopSettings {
  id     String @id @default(cuid())
  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  onboardingCompleted    Boolean           @default(false)
  plan                   String?
  recoveryDelayMinutes   Int               @default(30)
  recoveryOfferMode      RecoveryOfferMode @default(NONE)
  fixedShopifyDiscountId String?
  fixedShopifyDiscount   ShopifyDiscount?  @relation("ShopSettingsFixedDiscount", fields: [fixedShopifyDiscountId], references: [id], onDelete: SetNull)
  followUpEnabled        Boolean           @default(false)
  followUpDelayMinutes   Int?
  defaultLanguageTag     String?
  defaultTimeZone        String?
  defaultCountryCode     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@schema("shopify")
}

enum RecoveryOfferMode {
  NONE
  FIXED
  AI_BEST_APPLICABLE

  @@schema("shopify")
}

enum ShopifyDiscountCatalogueStatus {
  UNAVAILABLE
  SYNC_REQUIRED
  SYNCING
  CURRENT
  ERROR

  @@schema("shopify")
}

enum ShopifyDiscountMethod {
  AUTOMATIC
  CODE

  @@schema("shopify")
}

model ShopifyDiscountCatalogue {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  status               ShopifyDiscountCatalogueStatus @default(UNAVAILABLE)
  syncGeneration       Int                            @default(0)
  activeSyncToken      String?
  syncRequestedAt      DateTime?
  syncStartedAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?                        @db.VarChar(128)
  unavailableAt        DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  discounts ShopifyDiscount[] @relation("ShopifyDiscountCatalogue")

  @@schema("shopify")
}

model ShopifyDiscount {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation("ShopifyDiscountShop", fields: [shopId], references: [id], onDelete: Cascade, map: "ShopifyDiscount_shop_fkey")

  shopifyDiscountNodeId  String
  providerType           String                @db.VarChar(128)
  method                 ShopifyDiscountMethod
  providerStatus         String                @db.VarChar(64)
  title                  String
  summary                String?
  startsAt               DateTime?
  endsAt                 DateTime?
  codeCount              Int?
  singleRedeemCode       String?
  fixedSelectable        Boolean               @default(false)
  providerSnapshot       Json
  isAvailable            Boolean               @default(false)
  lastSeenSyncGeneration Int
  lastSyncedAt           DateTime
  unavailableAt          DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  catalogue                  ShopifyDiscountCatalogue     @relation("ShopifyDiscountCatalogue", fields: [shopId], references: [shopId], onDelete: Cascade, map: "ShopifyDiscount_catalogue_fkey")
  settingsUsingFixed         ShopSettings[]               @relation("ShopSettingsFixedDiscount")
  policyOverridesUsingFixed  ShopRecoveryPolicyOverride[] @relation("PolicyOverrideFixedDiscount")
  outreachAttemptsUsingFixed RecoveryOutreachAttempt[]    @relation("OutreachAttemptFixedDiscount")

  @@unique([shopId, shopifyDiscountNodeId])
  @@index([shopId, isAvailable, providerStatus])
  @@index([shopId, fixedSelectable, isAvailable])
  @@index([shopId, startsAt, endsAt])
  @@schema("shopify")
}

model ShopRecoveryPolicyOverride {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  recoveryDelayMinutes     Int
  recoveryOfferMode        RecoveryOfferMode
  fixedShopifyDiscountId   String?
  fixedShopifyDiscount     ShopifyDiscount?  @relation("PolicyOverrideFixedDiscount", fields: [fixedShopifyDiscountId], references: [id], onDelete: SetNull)
  followUpEnabled          Boolean
  followUpDelayMinutes     Int?
  reason                   String            @db.VarChar(1000)
  expiresAt                DateTime?
  updatedByPlatformAdminId String
  updatedByPlatformAdmin   PlatformAdmin     @relation(fields: [updatedByPlatformAdminId], references: [id])
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@schema("shopify")
}

enum ShopRecoveryPolicyOverrideAuditAction {
  UPSERT
  CLEAR

  @@schema("shopify")
}

model ShopRecoveryPolicyOverrideAuditEvent {
  id String @id @default(cuid())

  shopId          String
  shop            Shop                                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platformAdminId String
  platformAdmin   PlatformAdmin                         @relation(fields: [platformAdminId], references: [id])
  action          ShopRecoveryPolicyOverrideAuditAction
  reason          String                                @db.VarChar(1000)
  beforeValue     Json?
  afterValue      Json?
  occurredAt      DateTime                              @default(now())

  @@index([shopId, occurredAt])
  @@index([platformAdminId, occurredAt])
  @@schema("shopify")
}

model ShopBrand {
  id String @id @default(cuid())

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  brandName String?

  logoUrl     String?
  logoAltText String?
  logoWidth   Int?
  logoHeight  Int?

  squareLogoUrl     String?
  squareLogoAltText String?

  coverImageUrl String?

  fetchedAt       DateTime @default(now())
  lastRefreshedAt DateTime @updatedAt

  @@schema("shopify")
}

model Customer {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  phone String?
  email String?

  firstName String?
  lastName  String?

  shopifyCustomerId String?

  phones                  CustomerPhone[]
  recoveries              CheckoutRecovery[]
  standaloneConversations Conversation[]     @relation("StandaloneConversationCustomer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, shopifyCustomerId])
  @@schema("commerce")
}

model CustomerPhone {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  phone String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, endedAt])
  @@index([phone, endedAt])
  @@schema("commerce")
}

enum CheckoutRecoveryStatus {
  DETECTED
  MESSAGE_SENT
  ENGAGED
  COMPLETED
  EXPIRED
  CANCELLED

  @@schema("commerce")
}

enum RecoveryAdmissionBlockReason {
  RECOVERY_CAPACITY_EXHAUSTED

  @@schema("commerce")
}

model CheckoutRecoveryStatusHistory {
  id String @id @default(cuid())

  checkoutRecoveryId String
  checkoutRecovery   CheckoutRecovery @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)

  fromStatus CheckoutRecoveryStatus?
  toStatus   CheckoutRecoveryStatus

  reason   String?
  source   String?
  metadata Json?

  occurredAt DateTime @default(now())

  @@index([checkoutRecoveryId, occurredAt])
  @@index([toStatus, occurredAt])
  @@schema("commerce")
}

model CheckoutRecovery {
  id String @id @default(cuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  checkoutToken String
  cartToken     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status     CheckoutRecoveryStatus @default(DETECTED)
  generation Int                    @default(1)

  currency    String?
  totalPrice  Decimal?
  checkoutUrl String?
  lineItems   Json?

  detectedAt             DateTime  @default(now())
  lastExternalActivityAt DateTime
  messageSentAt          DateTime?
  engagedAt              DateTime?
  completedAt            DateTime?
  expiredAt              DateTime?

  admissionBlockedAt   DateTime?
  admissionBlockReason RecoveryAdmissionBlockReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation     Conversation?
  statusHistory    CheckoutRecoveryStatusHistory[]
  outreachAttempts RecoveryOutreachAttempt[]

  @@unique([shopId, checkoutToken, generation])
  @@index([shopId, checkoutToken, generation])
  @@index([status, lastExternalActivityAt])
  @@index([customerId])
  @@index([shopId, admissionBlockReason, status, detectedAt])
  @@index([shopId, detectedAt, id])
  @@index([shopId, status, detectedAt, id])
  @@index([shopId, customerId, detectedAt, id])
  @@schema("commerce")
}

enum RecoveryOutreachTrigger {
  INITIAL
  NO_RESPONSE_FOLLOW_UP

  @@schema("commerce")
}

enum RecoveryOutreachStatus {
  PENDING
  WAITING_FOR_RESPONSE
  ENGAGED
  NO_RESPONSE
  CAPACITY_BLOCKED
  CANCELLED
  FAILED

  @@schema("commerce")
}

model RecoveryOutreachAttempt {
  id String @id @default(cuid())

  checkoutRecoveryId String
  checkoutRecovery   CheckoutRecovery        @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)
  sequence           Int
  trigger            RecoveryOutreachTrigger
  status             RecoveryOutreachStatus  @default(PENDING)

  configuredOfferMode    RecoveryOfferMode
  fixedShopifyDiscountId String?
  fixedShopifyDiscount   ShopifyDiscount?  @relation("OutreachAttemptFixedDiscount", fields: [fixedShopifyDiscountId], references: [id], onDelete: SetNull)
  offerSnapshot          Json?

  outboundMessageId String?              @unique
  outboundMessage   ConversationMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)

  followUpDueAt       DateTime?
  sentAt              DateTime?
  customerRespondedAt DateTime?
  closedAt            DateTime?
  failureCode         String?   @db.VarChar(128)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([checkoutRecoveryId, sequence])
  @@index([checkoutRecoveryId, status, sequence])
  @@index([status, followUpDueAt])
  @@schema("commerce")
}

enum ConversationType {
  RECOVERY
  PRODUCT_DISCOVERY
  PRODUCT_SUPPORT
  POST_PURCHASE

  @@schema("whatsapp")
}

enum LanguageSource {
  CUSTOMER_EXPLICIT
  DETECTED
  SHOPIFY
  MERCHANT_DEFAULT
  PLATFORM_DEFAULT

  @@schema("whatsapp")
}

enum ConversationOutcome {
  IN_PROGRESS
  RECOVERED
  NO_RESPONSE
  DECLINED
  EXPIRED

  @@schema("whatsapp")
}

model Conversation {
  commerceGrant CommerceConversationGrant?

  id String @id @default(cuid())

  shopId     String?
  shop       Shop?     @relation("StandaloneConversationShop", fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation("StandaloneConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  checkoutRecoveryId String?
  checkoutRecovery   CheckoutRecovery? @relation(fields: [checkoutRecoveryId], references: [id], onDelete: Cascade)
  standaloneScopeKey String?           @unique @db.VarChar(255)

  type    ConversationType
  outcome ConversationOutcome @default(IN_PROGRESS)

  languageTag    String?
  languageSource LanguageSource?
  countryCode    String?
  currencyCode   String?
  timeZone       String?

  inboundVersion           Int       @default(0)
  lastProcessedVersion     Int       @default(0)
  pendingTurnStartedAt     DateTime?
  processingInboundVersion Int?
  processingStartedAt      DateTime?

  summary String?

  lastInboundAt DateTime?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@unique([checkoutRecoveryId])
  @@index([checkoutRecoveryId])
  @@index([shopId, customerId, type, outcome])
  @@index([customerId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([processingStartedAt])
  @@schema("whatsapp")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@schema("whatsapp")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  AUTOMATION
  HUMAN

  @@schema("whatsapp")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@schema("whatsapp")
}

enum MessageContentType {
  TEXT
  AUDIO
  UNSUPPORTED

  @@schema("whatsapp")
}

enum MessageTranscriptionStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  REJECTED
  FAILED

  @@schema("whatsapp")
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Meta's WhatsApp message ID
  providerMessageId String? @unique

  // Meta context.id when this message is a reply
  inReplyToProviderId String?

  direction  MessageDirection
  senderType MessageSenderType
  status     MessageStatus     @default(PENDING)

  content                  String
  contentType              MessageContentType         @default(TEXT)
  providerMediaId          String?
  providerMediaMimeType    String?
  providerMediaSha256      String?
  mediaDurationMs          Int?
  transcriptionStatus      MessageTranscriptionStatus @default(NOT_REQUIRED)
  transcriptionProvider    String?
  transcriptionModel       String?
  transcriptionFailureCode String?
  transcriptionCompletedAt DateTime?

  createdAt DateTime @default(now())

  recoveryOutreachAttempt RecoveryOutreachAttempt?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([inReplyToProviderId])
  @@schema("whatsapp")
}

enum BillingPlanKind {
  FREE
  PAID_METERED

  @@schema("billing")
}

enum FeatureActivationMode {
  ALWAYS_ENABLED
  MERCHANT_OPT_IN

  @@schema("billing")
}

model Feature {
  commerceCapabilities         CommerceCapability[]
  commerceFeatureConfiguration CommerceFeatureConfiguration?
  commerceReleaseFeatures      CommerceReleaseFeature[]
  commerceAuditEvents          CommerceAuditEvent[]

  id String @id @default(cuid())

  key            String                @unique @db.VarChar(128)
  displayName    String                @db.VarChar(255)
  description    String?               @db.Text
  active         Boolean               @default(true)
  activationMode FeatureActivationMode
  systemRequired Boolean               @default(false)

  merchantPricingPlans MerchantPricingPlanFeature[]
  billingPlans         BillingPlanFeature[]
  shopPreferences      ShopFeaturePreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayName])
  @@schema("billing")
}

enum SubscriptionProjectionStatus {
  ACTIVE
  TRIALING
  NO_CONTRACT
  UNMAPPED
  SYNC_ERROR
  FROZEN

  @@schema("billing")
}

enum ProviderSubscriptionLifecycleState {
  CREATED
  UPDATED
  CANCELLATION_SCHEDULED
  CANCELED
  FROZEN
  UNFROZEN

  @@schema("billing")
}

enum BillingPeriodStatus {
  OPEN
  CLOSED

  @@schema("billing")
}

enum BillingPeriodCloseReason {
  RENEWED_SAME_PLAN
  PLAN_CHANGED
  CONTRACT_ENDED

  @@schema("billing")
}

enum EntitlementCounter {
  LIFETIME_FREE_RECOVERY_CREDITS
  PURCHASED_RECOVERY_CREDITS

  @@schema("billing")
}

enum BillingPeriodEntitlementCounterKind {
  INCLUDED_RECOVERY_CREDITS

  @@schema("billing")
}

enum UsageReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  AMBIGUOUS

  @@schema("billing")
}

enum UsageReservationReleaseReason {
  PERIOD_CLOSED

  @@schema("billing")
}

enum UsageMetric {
  RECOVERY_CONVERSATION
  OUTBOUND_AUTOMATED_MESSAGE
  DELIVERED_WHATSAPP_MESSAGE
  RECOVERY_CREDIT_PACK_PURCHASE

  @@schema("billing")
}

enum RecoveryCreditPurchaseStatus {
  REQUESTED
  ACTIVE
  COMPLETED
  WITHDRAWN
  REFUNDED

  @@schema("billing")
}

enum BillingLifecycleRequestSource {
  MERCHANT_UI
  MERCHANT_SUPPORT
  ADMIN

  @@schema("billing")
}

enum RecoveryCreditProviderActionKind {
  REFUND
  CREDIT

  @@schema("billing")
}

enum RecoveryCreditRefundStatus {
  REQUESTED
  PROVIDER_ACTION_REQUIRED
  COMPLETED
  REJECTED
  CANCELLED
  NEEDS_ATTENTION

  @@schema("billing")
}

enum ShopifyReportState {
  NOT_APPLICABLE
  PENDING
  IN_FLIGHT
  RETRYABLE
  REPORTED
  NEEDS_ATTENTION

  @@schema("billing")
}

enum BillingAuditAction {
  PLAN_CATALOG_CHANGED
  PLATFORM_POLICY_CHANGED
  SHOP_OVERRIDE_CHANGED
  SHOP_OVERRIDE_EXPIRED
  AUTOMATION_PAUSED
  AUTOMATION_RESUMED
  BILLING_EVENT_RETRY
  BILLING_CORRECTION_CREATED
  RECOVERY_CREDIT_REFUND
  UPGRADE_ECONOMICS_EVALUATED

  @@schema("billing")
}

enum MerchantPricingPlanKind {
  FREE
  PAID_METERED

  @@schema("billing")
}

enum MerchantPricingAllowancePeriod {
  LIFETIME
  EVERY_30_DAYS

  @@schema("billing")
}

enum MerchantPricingBillingPeriod {
  EVERY_30_DAYS

  @@schema("billing")
}

enum MerchantPricingUsagePricingMode {
  FIXED
  GRADUATED
  VOLUME

  @@schema("billing")
}

model MerchantPricingPlan {
  id                String @id @default(cuid())
  shopifyPlanHandle String @unique

  displayName                        String
  planKind                           MerchantPricingPlanKind
  isActive                           Boolean                        @default(true)
  cataloguePosition                  Int
  featured                           Boolean                        @default(false)
  includedRecoveryCredits            Int
  allowancePeriod                    MerchantPricingAllowancePeriod
  billingPeriod                      MerchantPricingBillingPeriod
  recurringAmountMinor               Int
  currency                           String                         @db.Char(3)
  economicsOverrideEnabled           Boolean                        @default(false)
  economicsOverrideReason            String?                        @db.Text
  economicsOverrideApprovedAt        DateTime?
  economicsOverrideApprovedByAdminId String?
  economicsOverrideFailureCodes      String[]                       @default([])
  economicsOverrideFingerprint       String?                        @db.VarChar(64)
  shopifyRecoveryUsageEventHandle    String?                        @db.VarChar(255)
  materializedAt                     DateTime?
  commerceModelId                    String?                        @db.Text

  translations  MerchantPricingPlanTranslation[]
  usageEvents   MerchantPricingUsageEvent[]
  highlights    MerchantPricingPlanHighlight[]
  features      MerchantPricingPlanFeature[]
  commerceModel CommerceModelCatalogueEntry?     @relation("MerchantPricingPlanCommerceModel", fields: [commerceModelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, cataloguePosition])
  @@index([planKind, isActive])
  @@index([commerceModelId])
  @@schema("billing")
}

model MerchantPricingPlanTranslation {
  id                    String              @id @default(cuid())
  merchantPricingPlanId String
  merchantPricingPlan   MerchantPricingPlan @relation(fields: [merchantPricingPlanId], references: [id], onDelete: Cascade)
  locale                String              @db.VarChar(16)
  merchantDescription   String              @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([merchantPricingPlanId, locale])
  @@schema("billing")
}

model MerchantPricingPlanHighlight {
  id                    String              @id @default(cuid())
  merchantPricingPlanId String
  merchantPricingPlan   MerchantPricingPlan @relation(fields: [merchantPricingPlanId], references: [id], onDelete: Cascade)

  contentKey String @db.Uuid
  position   Int

  translations MerchantPricingPlanHighlightTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantPricingPlanId, contentKey])
  @@unique([merchantPricingPlanId, position])
  @@index([merchantPricingPlanId])
  @@schema("billing")
}

model MerchantPricingPlanHighlightTranslation {
  id                             String                       @id @default(cuid())
  merchantPricingPlanHighlightId String
  merchantPricingPlanHighlight   MerchantPricingPlanHighlight @relation(fields: [merchantPricingPlanHighlightId], references: [id], onDelete: Cascade)

  locale              String @db.VarChar(16)
  merchantTitle       String @db.VarChar(120)
  merchantDescription String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantPricingPlanHighlightId, locale])
  @@schema("billing")
}

model MerchantPricingUsageEvent {
  id                           String                          @id @default(cuid())
  merchantPricingPlanId        String
  merchantPricingPlan          MerchantPricingPlan             @relation(fields: [merchantPricingPlanId], references: [id], onDelete: Cascade)
  eventHandle                  String
  adminLabel                   String
  creditsGrantedPerUnit        Int
  position                     Int
  pricingMode                  MerchantPricingUsagePricingMode
  currency                     String                          @db.Char(3)
  fixedUnitAmountMinor         Int?
  maximumUnitsPerBillingPeriod Int?
  tiers                        MerchantPricingUsageTier[]
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@unique([merchantPricingPlanId, eventHandle])
  @@unique([merchantPricingPlanId, position])
  @@schema("billing")
}

model MerchantPricingUsageTier {
  id                          String                    @id @default(cuid())
  merchantPricingUsageEventId String
  merchantPricingUsageEvent   MerchantPricingUsageEvent @relation(fields: [merchantPricingUsageEventId], references: [id], onDelete: Cascade)
  position                    Int
  upTo                        Int?
  amountPerUnitMinor          Int
  flatAmountMinor             Int

  @@unique([merchantPricingUsageEventId, position])
  @@schema("billing")
}

model BillingPlan {
  id String @id @default(cuid())

  shopifyPlanHandle String          @unique
  name              String
  kind              BillingPlanKind
  active            Boolean         @default(true)

  shopifyUsageEventHandle               String?
  includedRecoveryConversationAllowance Int?
  recoveryCreditPackEnabled             Boolean @default(false)
  recoveryCreditsPerPack                Int?
  shopifyRecoveryCreditPackEventHandle  String?

  features                BillingPlanFeature[]
  subscriptions           Subscription[]
  pendingSubscriptions    Subscription[]                @relation("PendingSubscriptionPlan")
  billingPeriods          BillingPeriod[]               @relation("BillingPeriodPlan")
  recoveryCreditPurchases RecoveryCreditPurchase[]
  promotionCampaigns      PromotionCampaign[]           @relation("PromotionCampaignTargetPlan")
  lowerUpgradeEdges       BillingUpgradeEconomicsEdge[] @relation("BillingUpgradeEconomicsLowerPlan")
  higherUpgradeEdges      BillingUpgradeEconomicsEdge[] @relation("BillingUpgradeEconomicsHigherPlan")
  economicsSnapshots      BillingEconomicsSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@schema("billing")
}

model BillingUpgradeEconomicsEdge {
  id String @id @default(cuid())

  lowerPlanId  String
  lowerPlan    BillingPlan @relation("BillingUpgradeEconomicsLowerPlan", fields: [lowerPlanId], references: [id], onDelete: Restrict)
  higherPlanId String
  higherPlan   BillingPlan @relation("BillingUpgradeEconomicsHigherPlan", fields: [higherPlanId], references: [id], onDelete: Restrict)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lowerPlanId])
  @@unique([higherPlanId])
  @@index([active])
  @@schema("billing")
}

model BillingEconomicsSnapshot {
  id String @id @default(cuid())

  billingPlanId                                String
  billingPlan                                  BillingPlan   @relation(fields: [billingPlanId], references: [id], onDelete: Restrict)
  shopifyPlanHandleSnapshot                    String
  monthlyRecurringAmountMinor                  Int
  currency                                     String        @db.Char(3)
  recoveryCreditPackEnabledSnapshot            Boolean
  recoveryCreditsPerPackSnapshot               Int?
  shopifyRecoveryCreditPackEventHandleSnapshot String?
  usagePricingSnapshot                         Json?
  providerEvidence                             Json?
  verifiedByPlatformAdminId                    String
  verifiedByPlatformAdmin                      PlatformAdmin @relation(fields: [verifiedByPlatformAdminId], references: [id], onDelete: Restrict)
  verificationReason                           String        @db.VarChar(1000)
  verifiedAt                                   DateTime
  createdAt                                    DateTime      @default(now())

  @@index([billingPlanId, verifiedAt])
  @@index([verifiedByPlatformAdminId, verifiedAt])
  @@schema("billing")
}

model BillingPlanFeature {
