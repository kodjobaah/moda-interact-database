@startuml erd
skinparam linetype ortho
enum "CheckoutRecoveryStatus" as CheckoutRecoveryStatus {
  DETECTED
  MESSAGE_SENT
  ENGAGED
  COMPLETED
  EXPIRED
  CANCELLED
}
enum "ConversationType" as ConversationType {
  RECOVERY
  PRODUCT_DISCOVERY
  PRODUCT_SUPPORT
  POST_PURCHASE
}
enum "ConversationOutcome" as ConversationOutcome {
  IN_PROGRESS
  RECOVERED
  NO_RESPONSE
  DECLINED
  EXPIRED
}
enum "MessageDirection" as MessageDirection {
  INBOUND
  OUTBOUND
}
enum "MessageSenderType" as MessageSenderType {
  CUSTOMER
  AGENT
  AUTOMATION
  HUMAN
}
enum "MessageStatus" as MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}
enum "ShopStatus" as ShopStatus {
  ACTIVE
  UNINSTALLED
  SUSPENDED
}
entity "Session" as Session {
+ id [PK] : String 
--
  * shop : String
  * state : String
  * isOnline : Boolean
  scope : String
  expires : DateTime
  * accessToken : String
  userId : BigInt
  firstName : String
  lastName : String
  email : String
  * accountOwner : Boolean
  locale : String
  collaborator : Boolean
  emailVerified : Boolean
  refreshToken : String
  refreshTokenExpires : DateTime
}

entity "ShopSettings" as ShopSettings {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  * onboardingCompleted : Boolean
  plan : String
  * recoveryDelayMinutes : Int
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "ShopBrand" as ShopBrand {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  brandName : String
  logoUrl : String
  logoAltText : String
  logoWidth : Int
  logoHeight : Int
  squareLogoUrl : String
  squareLogoAltText : String
  coverImageUrl : String
  * fetchedAt : DateTime
  * lastRefreshedAt : DateTime
}

entity "Customer" as Customer {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  phone : String
  email : String
  firstName : String
  lastName : String
  shopifyCustomerId : String
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "CustomerPhone" as CustomerPhone {
+ id [PK] : String 
--
  # customerId : [FK] Customer
  * phone : String
  * startedAt : DateTime
  endedAt : DateTime
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "CheckoutRecoveryStatusHistory" as CheckoutRecoveryStatusHistory {
+ id [PK] : String 
--
  # checkoutRecoveryId : [FK] CheckoutRecovery
  fromStatus : CheckoutRecoveryStatus
  * toStatus : CheckoutRecoveryStatus
  reason : String
  source : String
  metadata : Json
  * occurredAt : DateTime
}

entity "CheckoutRecovery" as CheckoutRecovery {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  * checkoutToken : String
  cartToken : String
  # customerId : [FK] Customer
  * status : CheckoutRecoveryStatus
  currency : String
  totalPrice : Decimal
  checkoutUrl : String
  lineItems : Json
  * detectedAt : DateTime
  messageSentAt : DateTime
  engagedAt : DateTime
  completedAt : DateTime
  expiredAt : DateTime
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Conversation" as Conversation {
+ id [PK] : String 
--
  # checkoutRecoveryId : [FK] CheckoutRecovery
  * type : ConversationType
  * outcome : ConversationOutcome
  * inboundVersion : Int
  * lastProcessedVersion : Int
  summary : String
  lastInboundAt : DateTime
  lastMessageAt : DateTime
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "ConversationMessage" as ConversationMessage {
+ id [PK] : String 
--
  # conversationId : [FK] Conversation
  providerMessageId : String
  inReplyToProviderId : String
  * direction : MessageDirection
  * senderType : MessageSenderType
  * status : MessageStatus
  * content : String
  * createdAt : DateTime
  sentAt : DateTime
  deliveredAt : DateTime
  readAt : DateTime
}

entity "BillingPlan" as BillingPlan {
+ id [PK] : String 
--
  * handle : String
  * name : String
  * entitlements : Json
  * limits : Json
  * active : Boolean
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Subscription" as Subscription {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  # planId : [FK] BillingPlan
  * provider : String
  * planHandle : String
  * status : String
  currentPeriodStart : DateTime
  currentPeriodEnd : DateTime
  trialEndsAt : DateTime
  * cancelAtPeriodEnd : Boolean
  providerSubscriptionId : String
  lastSyncedAt : DateTime
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "UsageEvent" as UsageEvent {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  # billingPeriodId : [FK] BillingPeriod
  * metric : String
  * quantity : Decimal
  * idempotencyKey : String
  sourceType : String
  sourceId : String
  * occurredAt : DateTime
  reportedAt : DateTime
  * provider : String
  providerResponse : Json
  * createdAt : DateTime
}

entity "BillingPeriod" as BillingPeriod {
+ id [PK] : String 
--
  # shopId : [FK] Shop
  * periodStart : DateTime
  * periodEnd : DateTime
  * status : String
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Shop" as Shop {
+ id [PK] : String 
--
  * domain : String
  shopifyShopId : String
  * status : ShopStatus
  * installedAt : DateTime
  uninstalledAt : DateTime
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Tour" as Tour {
+ id [PK] : String 
--
  * createdAt : DateTime
  * updatedAt : DateTime
  * city : String
  * country : String
  * title : String
  * description : String
  image : String
  * stops : Json
}

entity "RagSearchResults" as RagSearchResults {
+ id [PK] : String 
--
  * createdAt : DateTime
  * updatedAt : DateTime
  * answer : Json
  * prompt : Json
  * astraDoc : String
}

' Relations
ShopSettings |o--|| Shop
ShopBrand |o--|| Shop
Customer }o--|| Shop
CustomerPhone }o--|| Customer
CheckoutRecoveryStatusHistory }o--|| CheckoutRecovery
CheckoutRecovery }o--|| Shop
CheckoutRecovery }o--o| Customer
Conversation |o--o| CheckoutRecovery
ConversationMessage }o--|| Conversation
Subscription |o--|| Shop
Subscription }o--o| BillingPlan
UsageEvent }o--|| Shop
UsageEvent }o--o| BillingPeriod
BillingPeriod }o--|| Shop
' ManyToMany Relations
' enum relations
CheckoutRecoveryStatusHistory |o--|| CheckoutRecoveryStatus
CheckoutRecoveryStatusHistory |o--|| CheckoutRecoveryStatus
CheckoutRecovery |o--|| CheckoutRecoveryStatus
Conversation |o--|| ConversationType
Conversation |o--|| ConversationOutcome
ConversationMessage |o--|| MessageDirection
ConversationMessage |o--|| MessageSenderType
ConversationMessage |o--|| MessageStatus
Shop |o--|| ShopStatus
@enduml